# true = run entirely in the browser against the mock API (no backend needed)
VITE_USE_MOCK=true
# Base path of the FastAPI backend. Vite proxies /api to localhost:8000 in dev.
VITE_API_BASE=/api/v1
# Public widget key (NOT a secret, only identifies the widget; see SECURITY-DESIGN)
VITE_WIDGET_KEY=dev-widget-key
